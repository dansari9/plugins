<?xml version="1.0" encoding="UTF-8"?>
<SNAP stateVersion="2" order="shift,drive,press,space" name="teeth in the low end" tags="FUN!,Dirty,Kick,FX" description="turns each kick into a growling rave bass hit: an acid sub layer with wide harmonics, tube drive on the lows and punch compression. set sub pitch to the key.">
  <PARAM id="sub_amt" value="45"/>
  <PARAM id="sub_sens" value="60"/>
  <PARAM id="sub_det_hi" value="140"/>
  <PARAM id="sub_pitch" value="33"/>
  <PARAM id="sub_decay" value="280"/>
  <PARAM id="sub_stereo" value="35"/>
  <PARAM id="sub_color" value="65"/>
  <PARAM id="sub_acid" value="1"/>
  <PARAM id="press_amt" value="30"/>
  <PARAM id="drive_amt" value="25"/>
  <PARAM id="drive_mode" value="3"/>
  <PARAM id="drive_flavor" value="0.3"/>
  <PARAM id="drive_focus_hi" value="800"/>
  <PARAM id="out_gain" value="-3.5"/>
  <PARAM id="attack" value="10"/>
  <PARAM id="clip_on" value="1"/>
</SNAP>
