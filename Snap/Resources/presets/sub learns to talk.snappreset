<?xml version="1.0" encoding="UTF-8"?>
<SNAP stateVersion="2" order="shift,press,drive,space" name="sub learns to talk" tags="Dirty,Fat,Kick,Instrument" description="makes long sub kicks and bass lines speak on small speakers: parallel desk drive for harmonics, glue, density above the fundamental and clipped peaks.">
  <PARAM id="press_amt" value="25"/>
  <PARAM id="press_mode" value="1"/>
  <PARAM id="drive_amt" value="45"/>
