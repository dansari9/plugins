  <PARAM id="press_amt" value="25"/>
  <PARAM id="out_gain" value="6.5"/>
  <PARAM id="cut_lo" value="400"/>
  <PARAM id="air" value="35"/>
  <PARAM id="attack" value="18"/>
  <PARAM id="sustain" value="-20"/>
</SNAP>
