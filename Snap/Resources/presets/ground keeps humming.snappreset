<?xml version="1.0" encoding="UTF-8"?>
<SNAP stateVersion="2" order="shift,press,drive,space" name="ground keeps humming" tags="Fat,Huge,Kick" description="turns short kicks into long tuned sub kicks: a pitched sub tail under each hit, warm low drive and clipped peaks. set sub pitch to the song&#x27;s key.">
