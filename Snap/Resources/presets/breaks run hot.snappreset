<?xml version="1.0" encoding="UTF-8"?>
<SNAP stateVersion="2" order="shift,press,drive,space" name="breaks run hot" tags="Punchy,Aggressive,Loop,Drum Bus" description="for fast chopped breaks: glue first, cassette spark on the attacks above the low end, two stages of density and clipped peaks, so the break cuts through a heavy bass line.">
  <PARAM id="press_amt" value="30"/>
  <PARAM id="press_mode" value="1"/>
  <PARAM id="drive_amt" value="25"/>
  <PARAM id="drive_mode" value="1"/>
  <PARAM id="drive_flavor" value="0.4"/>
  <PARAM id="drive_target" value="-0.4"/>
  <PARAM id="drive_focus_lo" value="200"/>
  <PARAM id="push_amt" value="30"/>
  <PARAM id="push_mult" value="1"/>
  <PARAM id="push_tone" value="0.3"/>
  <PARAM id="push_target" value="-0.3"/>
  <PARAM id="push_focus_lo" value="150"/>
  <PARAM id="out_gain" value="-2.5"/>
  <PARAM id="cut_lo" value="35"/>
  <PARAM id="air" value="15"/>
  <PARAM id="attack" value="22"/>
  <PARAM id="sustain" value="5"/>
  <PARAM id="clip_on" value="1"/>
</SNAP>
